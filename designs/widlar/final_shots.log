\i     rs = results()
\i     printf("MCP:results %s = %L\n" dir rs)
\i     ok = nil
\i     foreach(rr rs
\i       unless(ok
\i         when( errset(selectResult(rr) nil)
\i           when( car(errset(getData(car(exprs)) nil))
\i             ok = rr)))
\i       )
\i     when(ok selectResult(ok)
\i       foreach(e exprs errset(plot(getData(e)) t)))
\i     printf("MCP:plotted %s via %L\n" dir ok)))
\t plotFromRun
